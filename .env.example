# ===== Thi Lốp AI Hub — file cấu hình =====
# Chép thành .env:  cp .env.example .env   rồi điền. KHÔNG đưa file .env lên GitHub.
# Chạy  ./deploy/gen-secrets.sh  để tự tạo POSTGRES_PASSWORD, JWT_SECRET, MESSENGER_VERIFY_TOKEN.

# --- Tên miền ---
# Có tên miền (đã trỏ về IP server): DOMAIN=ai.thilop.vn  → tự có HTTPS
# Chạy thử bằng IP, chưa có tên miền:  DOMAIN=:80
DOMAIN=:80
PUBLIC_BASE_URL=http://IP-SERVER-CUA-ANH

# --- Bảo mật (gen-secrets.sh tự điền) ---
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Tài khoản admin tạo lần đầu (đăng nhập xong nhớ đổi mật khẩu) ---
ADMIN_EMAIL=admin@thilop.vn
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị

# --- Key các hãng AI (lấy trên trang console của từng hãng) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Giọng đọc FPT.AI (console.fpt.ai) ---
FPT_TTS_API_KEY=

# --- Telegram: bot báo hạn mức và ca chuyển người (tạo bot qua @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Messenger (fanpage) — điền khi nối fanpage, xem INSTALL.md mục 7 ---
MESSENGER_PAGE_ID=
MESSENGER_PAGE_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# --- Zalo OA — điền khi nối Zalo OA, xem INSTALL.md mục 8 ---
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_REFRESH_TOKEN=

# Chế độ thử: 1 = không gọi AI thật (để kiểm tra giao diện khi chưa có key)
MOCK_LLM=0
